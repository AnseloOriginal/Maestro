<!DOCTYPE html>
<html>
<body>
<button id="sendBtn">Send POST</button>

<script>
document.getElementById('sendBtn').addEventListener('click', () => {
  let sul = "man"
    fetch('/', {
        method: 'POST',
        body: new URLSearchParams({ user: 'Ansel', peterson: sul, data: null })
    })
    .then(response => response.text()) // Expect plain text from PHP
    .then(data => {
        console.log('Server says:', data);
        alert(data); // Show in popup
    })
    .catch(error => {
        console.error('Error:', error);
    });
});
</script>
</body>
</html>